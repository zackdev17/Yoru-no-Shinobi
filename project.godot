config_version=5

[application]

config/name="Yoru no Shinobi (4.4) (4.4)"
config/description="Endless ninja run (day & night stages) with complex 2D lighting (normal maps, shadows, bloom, weather)."
run/main_scene="res://scenes/boot.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.png"

[autoload]

GameState="*res://autoload/game_state.gd"
Sfx="*res://autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=576
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=0

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.07, 1)
2d/snap/snap_2d_transforms_to_pixel=true

